# Copy to .env and fill in your own Supabase project values.
# NEVER commit the real .env — see the security note in README.md.
#
# WARNING: every VITE_* variable is inlined into the public JavaScript bundle
# at build time. None of these is a secret from the browser. Do not put a
# service-role key or anything that must stay private here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Gate for the updater/KPI pages. Client-side only — see README security note.
VITE_UPDATER_PIN=0000
